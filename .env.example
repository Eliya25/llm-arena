# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres connection string for Prisma
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Arcjet — https://app.arcjet.com
ARCJET_KEY=

# PostHog — https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Separate Prisma Postgres instance for the database tests (pnpm test).
# Never the same as DATABASE_URL — the suite refuses to run if it is.
TEST_DATABASE_URL=

# Bearer secret used only by the deployment smoke check.
HEALTHCHECK_SECRET=

# Dedicated load Preview only. The route also refuses this mode on Vercel Production.
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
LOAD_TEST_MODE=false
LOAD_TEST_SECRET=
